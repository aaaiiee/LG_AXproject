ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5

LG_DASH_DB_PATH=storage/db.sqlite
LG_DASH_IMAGE_DIR=storage/images

CRAWL_USER_AGENT="LG_Dash/0.0.1 (+internal-use)"
CRAWL_TIMEOUT_SECONDS=30
# Default per-host minimum delay (seconds). Per-host overrides in code:
#   search.danawa.com=10.0 (their robots.txt Crawl-delay)
#   prod.danawa.com=2.0, www.coupang.com=2.0, www.youtube.com=2.0
CRAWL_RATE_LIMIT_PER_HOST=1.0
